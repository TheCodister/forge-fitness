# Frontend (embedded by Next.js during the Amplify build)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_EXERCISE_IMAGE_BASE_URL=https://example.com/exercises

# Fastify backend
PORT=4000
HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=25000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/forge_fitness
JWT_SECRET=replace-with-at-least-32-random-characters
# Existing installations may temporarily keep NEXTAUTH_SECRET instead.

# Use "none" when the deployed frontend and API are on different sites.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# Optional Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Existing integrations
# EXERCISE_IMAGE_BASE_URL=https://example.com/exercises
# EXERCISEDB_API_KEY=
# AI_SETTINGS_ENCRYPTION_KEY=
