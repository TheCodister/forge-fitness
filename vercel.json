{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @forge/web...",
  "buildCommand": "pnpm --filter @forge/web run build",
  "outputDirectory": "apps/web/out",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/workouts/:id", "destination": "/workouts/_/" },
    { "source": "/templates/:id", "destination": "/templates/_/" },
    { "source": "/trainer/:conversationId", "destination": "/trainer/_/" }
  ]
}
