{
  "name": "forge-fitness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "next build",
    "build:frontend": "next build",
    "build:backend": "pnpm --dir backend build",
    "start": "pnpm start:backend",
    "start:frontend": "next dev",
    "start:backend": "pnpm --dir backend start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "pnpm --dir backend prisma:generate",
    "db:push": "pnpm --dir backend db:push",
    "db:migrate:deploy": "pnpm --dir backend db:migrate:deploy",
    "db:seed": "pnpm --dir backend db:seed",
    "db:seed:test-user": "pnpm --dir backend db:seed:test-user",
    "db:migrate-exercise-images": "pnpm --dir backend db:migrate-exercise-images"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "packageExtensions": {
      "@fastify/cookie@*": {
        "peerDependencies": {
          "fastify": "^5.0.0"
        }
      },
      "@fastify/jwt@*": {
        "peerDependencies": {
          "fastify": "^5.0.0"
        }
      }
    },
    "overrides": {
      "@hono/node-server": "1.19.14",
      "postcss": "8.5.10"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.15.0"
}
