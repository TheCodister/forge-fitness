{
  "name": "forge-fitness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @forge/web run dev",
    "dev:api": "pnpm --filter @forge/api run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @forge/web run test:e2e"
  },
  "devDependencies": {
    "typescript": "^6"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.14",
      "postcss": "8.5.10"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
