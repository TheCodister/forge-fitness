{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["backend/**/*.ts", "src/lib/server/**/*.ts", "src/lib/db/**/*.ts", "src/lib/schemas/**/*.ts", "src/lib/http.ts", "src/lib/exercise-images.ts", "src/generated/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
