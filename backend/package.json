{
  "name": "forge-fitness-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx server.ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "node ../prisma/seed.mjs",
    "db:seed:test-user": "node ../prisma/seed-test-user.mjs",
    "db:migrate-exercise-images": "node ../prisma/migrate-exercise-images.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.2",
    "@langchain/anthropic": "^1.3.28",
    "@langchain/core": "^1.1.44",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "pg": "^8.20.0",
    "tsx": "^4.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.15.0"
}
