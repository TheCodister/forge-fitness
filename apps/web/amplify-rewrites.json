    "target": "/workouts/_/index.html",
    "status": "200"
  },
  {
    "source": "/templates/<id>/",
    "target": "/templates/_/index.html",
    "status": "200"
  },
  {
    "source": "/templates/<id>",
    "target": "/templates/_/index.html",
    "status": "200"
  },
  {
    "source": "/trainer/<conversationId>/",
    "target": "/trainer/_/index.html",
    "status": "200"
  },
  {
    "source": "/trainer/<conversationId>",
