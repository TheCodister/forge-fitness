{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "echo '@forge/api has no eslint config; typecheck covers this package'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:test-user": "node prisma/seed-test-user.mjs",
    "db:migrate-exercise-images": "node prisma/migrate-exercise-images.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/oauth2": "^8.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@forge/shared": "workspace:*",
    "@langchain/anthropic": "^1.3.28",
    "@langchain/core": "^1.1.44",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.1",
    "jose": "^6.2.2",
    "langchain": "^1.3.5",
    "pg": "^8.20.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26",
    "eslint": "^9",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^6",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
