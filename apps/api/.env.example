NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://user:pass@localhost:5432/forge
JWT_SECRET=change-me-32-chars-minimum-1234567890
JWT_TTL_SECONDS=604800
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Server-side crypto for stored per-user AI provider keys (32 bytes hex).
ENCRYPTION_SECRET=

# LangChain provider keys (optional).
GEMINI_API_KEY=
EXERCISEDB_API_KEY=
EXERCISE_IMAGE_BASE_URL=

# Google OAuth (optional — routes at /auth/google and
# /auth/google/callback register only if all three are set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where to land the browser after an OAuth callback succeeds.
POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard
